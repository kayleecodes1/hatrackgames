---
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Hatrack Games is an independent game studio."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Hatrack Games</title>
  </head>
  <body>
    <main>
      <section aria-labelledby="studio-name">
        <h1 id="studio-name">Hatrack Games</h1>
        <p>Playful indie games full of charm and surprises.</p>
        <nav aria-label="Company links">
          <a href="mailto:hello@hatrackgames.com">Contact</a>
        </nav>
      </section>
    </main>
    <footer>
      <small>&copy; {year} Hatrack Games LLC</small>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    color-scheme: dark;
    background: #11100f;
    color: #f5f1e8;
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
    display: grid;
    grid-template-rows: 1fr auto;
  }

  main {
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 10vw, 6rem);
    letter-spacing: -0.06em;
  }

  p {
    margin: 1rem 0 1.5rem;
    color: #bdb6a9;
  }

  a {
    color: inherit;
    text-underline-offset: 0.25em;
  }

  footer {
    padding: 1.5rem;
    text-align: center;
    color: #8d877d;
  }
</style>
